---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => (path === "/" ? `${baseUrl}/` || "/" : `${baseUrl}${path}`);
---

<footer class="site-footer">
  <div class="footer-identity">
    <div class="footer-portrait">
      <img
        src={withBase("/assets/charles-antoine-menanteau.jpg")}
        alt="Portrait de Charles-Antoine Menanteau"
        loading="lazy"
      />
    </div>
    <div class="footer-identity-copy">
      <h3>Charles-Antoine Menanteau</h3>
      <p>Psychologue clinicien • Psychothérapeute<br />Hypnothérapeute</p>
      <p>Une pratique clinique attentive à l’expérience vécue, aux crises de sens et aux transformations intérieures.</p>
    </div>
  </div>
  <div>
    <h4>Informations pratiques</h4>
    <p>Cabinets à Nantes et Clisson</p>
    <p>Sur rendez-vous</p>
  </div>
  <div>
    <h4>Contact</h4>
    <p><a href="tel:+33675184758">06 75 18 47 58</a></p>
    <p><a href="mailto:charlesmenanteau@gmail.com">charlesmenanteau@gmail.com</a></p>
    <p>
      <a
        href="https://www.doctolib.fr/psychologue/nantes/charles-antoine-menanteau"
        target="_blank"
        rel="noopener noreferrer"
      >Prendre rendez-vous sur Doctolib</a>
    </p>
  </div>
</footer>
