---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Page introuvable | Charles-Antoine Menanteau" description="La page demandée est introuvable." currentPath="/404" noindex>
  <section class="page-section">
    <h1>Page introuvable</h1>
    <p>La page demandée n’existe pas.</p>
    <a class="text-link" href={`${baseUrl}/`}>Revenir à l’accueil</a>
  </section>
</BaseLayout>
