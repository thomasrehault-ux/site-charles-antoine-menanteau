---
import BaseLayout from "../layouts/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path) => (path === "/" ? `${baseUrl}/` || "/" : `${baseUrl}${path}`);
---

<BaseLayout
  title="Contact | Charles-Antoine Menanteau"
  description="Contact, prise de rendez-vous, cabinets à Nantes et Clisson."
  currentPath="/contact"
>
  <section class="page-hero-grid">
    <div class="page-hero-copy">
      <p class="page-eyebrow">Contact</p>
      <h1>Prendre contact pour un premier échange ou une demande de rendez-vous.</h1>
      <span class="heading-rule"></span>
      <p class="page-intro">
        Cette page rassemble les informations pratiques pour les consultations en cabinet à Nantes
        et à Clisson, ainsi qu’un premier point de contact.
      </p>
    </div>
    <div class="page-hero-visual">
      <div class="page-hero-art page-hero-art-interior"></div>
    </div>
  </section>

  <section class="dynamic-grid dynamic-grid-2 page-section">
    <article class="content-card dynamic-panel contact-card">
      <div class="contact-card-heading">
        <span class="dynamic-kicker">Rendez-vous</span>
        <h2 class="contact-card-title">Consultations</h2>
      </div>
      <p>En cabinet à Nantes et à Clisson, sur rendez-vous.</p>
    </article>
    <article class="content-card dynamic-panel contact-card">
      <div class="contact-card-heading">
        <span class="dynamic-kicker">Contact direct</span>
        <h2 class="contact-card-title">Coordonnées</h2>
      </div>
      <div class="contact-details">
        <p><a href="tel:+33675184758">06 75 18 47 58</a></p>
        <p><a href="mailto:charlesmenanteau@gmail.com">charlesmenanteau@gmail.com</a></p>
        <a
          class="text-link"
          href="https://www.doctolib.fr/psychologue/nantes/charles-antoine-menanteau"
          target="_blank"
          rel="noopener noreferrer"
        >Prendre rendez-vous sur Doctolib</a>
      </div>
    </article>
  </section>

  <section class="cabinet-image page-section">
    <img src={withBase("/assets/cabinet-cta.png")} alt="Espace de consultation calme et lumineux" loading="lazy" />
  </section>
</BaseLayout>
