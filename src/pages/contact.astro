---
import BaseLayout from "../layouts/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path) => (path === "/" ? `${baseUrl}/` || "/" : `${baseUrl}${path}`);
---

<BaseLayout
  title="Contact | Charles-Antoine Menanteau"
  description="Contact, prise de rendez-vous, cabinets à Nantes et Clisson."
  currentPath="/contact"
>
  <section class="page-hero-grid">
    <div class="page-hero-copy">
      <p class="page-eyebrow">Contact</p>
      <h1>Prendre contact pour un premier échange ou une demande de rendez-vous.</h1>
      <span class="heading-rule"></span>
      <p class="page-intro">
        Cette page rassemble les informations pratiques pour les consultations en cabinet à Nantes
        et à Clisson, ainsi qu’un premier point de contact.
      </p>
    </div>
    <div class="page-hero-visual">
      <div class="page-hero-art page-hero-art-interior"></div>
    </div>
  </section>

  <section class="dynamic-grid dynamic-grid-2 page-section">
    <article class="content-card dynamic-panel contact-card">
      <div class="contact-card-heading">
        <span class="dynamic-kicker">Rendez-vous</span>
        <h2 class="contact-card-title">Consultations</h2>
      </div>
      <p>En cabinet à Nantes et à Clisson, sur rendez-vous.</p>
    </article>
    <article class="content-card dynamic-panel contact-card">
      <div class="contact-card-heading">
        <span class="dynamic-kicker">Prise de rendez-vous</span>
        <h2 class="contact-card-title">Doctolib</h2>
      </div>
      <div class="contact-details">
        <a
          class="text-link"
          href="https://www.doctolib.fr/psychologue/nantes/charles-antoine-menanteau"
          target="_blank"
          rel="noopener noreferrer"
        >Prendre rendez-vous sur Doctolib</a>
      </div>
    </article>
  </section>

  <section class="cabinet-gallery page-section" aria-labelledby="cabinet-gallery-title">
    <div class="section-heading">
      <p class="page-eyebrow">Le cabinet</p>
      <h2 id="cabinet-gallery-title">Découvrir l’espace de consultation</h2>
      <span class="heading-rule"></span>
    </div>
    <div class="cabinet-gallery-grid">
      <figure>
        <img
          src={withBase("/assets/cabinet-vue-generale.jpg")}
          alt="Vue générale du cabinet et de son espace d’accueil"
          loading="lazy"
          width="1600"
          height="1200"
        />
      </figure>
      <figure>
        <img
          src={withBase("/assets/cabinet-espace-therapeutique.jpg")}
          alt="Fauteuil et espace thérapeutique du cabinet"
          loading="lazy"
          width="1600"
          height="1200"
        />
      </figure>
    </div>
  </section>
</BaseLayout>
